# Historical raw outputs are packaged in artifacts/legacy-results.tar.gz.
/old_results/
/test_results/*
!/test_results/resnet_sweep_t32_d35_max80/
!/test_results/README.md
/S*.csv
/S*.log
*.tmp
.runner.lock

/artifacts/legacy-results.tar.gz

